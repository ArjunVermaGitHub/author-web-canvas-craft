
{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/Raghav-Kartikeya-Sample-Chapters.pdf",
      "status": 302,
      "headers": {
        "Location": "https://author-web-canvas-craft.lovable.app/__l5e/assets-v1/50f75e7b-5ecd-4686-82ee-37d647f2b25a/Raghav-Kartikeya-Sample-Chapters.pdf"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
